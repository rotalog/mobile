{
  "expo": {
    "name": "Rotalog",
    "slug": "rotalog",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rotalog",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rotalog.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Rotalog usa sua localização para acompanhar entregas e rotas.",
        "NSPhotoLibraryUsageDescription": "O Rotalog acessa fotos para anexar comprovantes de entrega.",
        "NSCameraUsageDescription": "O Rotalog usa a câmera para registrar comprovantes de entrega."
      }
    },
    "android": {
      "package": "com.rotalog.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "7f0bbb20-d0e5-4063-b491-cfbad5ccbf31"
      }
    }
  }
}
