{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "jest"
    ],
    "baseUrl": "./src",
    "paths": {
      "@navigation/*": [
        "navigation/*"
      ],
      "@contexts/*": [
        "contexts/*"
      ],
      "@hooks/*": [
        "hooks/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@auth/*": [
        "auth/*"
      ],
      "@buyer/*": [
        "buyer/*"
      ],
      "@driver/*": [
        "driver/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}